{
    "name": "schachbulle/contao-schachcomputer-bundle",
    "type": "contao-bundle",
    "description": "Gewertete Schachpartien gegen Stockfish im Browser für Contao: Bedenkzeiten aus dem Backend, Glicko-2-Wertung je Klasse, Ranglisten, Übungspartien und PGN-Archiv.",
    "keywords": [
        "contao",
        "schach",
        "chess",
        "stockfish",
        "schachcomputer",
        "engine",
        "rangliste",
        "glicko"
    ],
    "homepage": "https://github.com/Samson1964/contao-schachcomputer-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.7",
        "p-chess/chess": "^1.2"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoSchachcomputerBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoSchachcomputerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoSchachcomputerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-schachcomputer-bundle/issues",
        "source": "https://github.com/Samson1964/contao-schachcomputer-bundle"
    }
}
